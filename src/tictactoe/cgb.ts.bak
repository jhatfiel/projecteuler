function choice<T>(arr: T[]): T { return arr[Math.floor(Math.random()*arr.length)]; }

enum GameType {
    HURDLE_RACE,
    ARCHERY,
    ROLLER_SPEED_SKATING,
    DIVING
};

const playerIdx: number = parseInt(readline());
const nbGames: number = parseInt(readline());
console.error({playerIdx, nbGames});

enum MoveType {
    UP,
    LEFT,
    DOWN,
    RIGHT
}
let moves = ['UP', 'LEFT', 'DOWN', 'RIGHT'];
function getMoveScores(gpu: string, reg: number[], gameType: GameType): number[] {
    switch (gameType) {
        case GameType.HURDLE_RACE: return getHurdleMoveScores(gpu, reg);
        case GameType.ARCHERY: return getArcheryMoveScores(gpu, reg);
        case GameType.ROLLER_SPEED_SKATING: return getSkatingMoveScores(gpu, reg);
        case GameType.DIVING: return getDivingMoveScores(gpu, reg);
    };
}

function getHurdleMoveScores(gpu: string, reg: number[]): number[] {
    let JUMP = MoveType.UP;
    let MOVE1 = MoveType.LEFT;
    let MOVE2 = MoveType.DOWN;
    let MOVE3 = MoveType.RIGHT;

    let result = [0, 0, 0, 0];

    let myPosition = reg[playerIdx];

    let distanceToHurdle = gpu.slice(myPosition).indexOf('#');

    let opp1Position = reg[(playerIdx+1)%3];
    let opp2Position = reg[(playerIdx+2)%3];
    let howFarAhead = myPosition - Math.max(opp1Position, opp2Position);

    //console.error(`STATE: ${gpu.slice(myPosition)}, ahead=${howFarAhead}`);

    if (reg[3+playerIdx] || // I'm stunned
        gpu === 'GAME_OVER' || // game over reset turn
        (myPosition+10 < opp1Position || myPosition+10 < opp2Position) || // lost cause?
        ((distanceToHurdle === -1 || distanceToHurdle > 3) && howFarAhead > 5) // I'm far ahead
        ) {
        // these are cases in which we don't really care what is done
        //result[MOVE3] = 0.6;
        //result[MOVE2] = result[JUMP]= 0.3;
        //result[MOVE1] = 0;
        console.error(`DON'T CARE:`, result);
        return result;
    }

    // we want to run right up to the hurdle and stop
    // .#.....
    if (distanceToHurdle === 1) {
        result[JUMP] = 10;
    // ..#....
    } else if (distanceToHurdle === 2) {
        result[MOVE1] = 10;
    // ...#...
    } else if (distanceToHurdle === 3) {
        result[MOVE1] = 5;
        result[JUMP] = result[MOVE2] = 10;
    } else {
        result[MOVE1] = 5;
        result[JUMP] = result[MOVE2] = 5.3;
        result[MOVE3] = 10;
    }
    console.error(`RESULT:`, result)
    return result;
}

// TODO: come up with "can't lose" and "can't win" conditions here as well based on distance from origin
function getArcheryMoveScores(gpu: string, reg: number[]): number[] {
    let result = [0, 0, 0, 0];
    if (gpu === 'GAME_OVER' ||
        gpu.length > turnsRemaining) {
        console.error(`DON'T CARE:`, result);
        return result;
    }

    let x = reg[playerIdx*2];
    let y = reg[playerIdx*2 + 1];
    let d = Number(gpu[0]);

    if (x > 0) result[MoveType.LEFT] = (x<2*d)?6:10;
    if (x === 0) result[MoveType.LEFT] = result[MoveType.RIGHT] = 4;
    if (x < 0) result[MoveType.RIGHT] = (x>-2*d)?6:10;
    if (y > 0) result[MoveType.UP] = (y<2*d)?6:10;
    if (y === 0) result[MoveType.UP] = result[MoveType.DOWN] = 4;
    if (y < 0) result[MoveType.DOWN] = (y<-2*d)?6:10;

    // if we only have 1 8, just go ahead and turn it into a 10 because that's what we want to do
    //if (result.filter(v => v==8).length === 1 && Math.max(...result) === 8) result = result.map(v => v?10:0);

    console.error(`RESULT:`, result)
    return result;
}

// action index 0 - move by 1 & decrease risk by 1
// action index 1 - move by 2
// action index 2 - move by 2 & increase risk by 1
// action index 3 - move by 3 & increase risk by 2
function getSkatingMoveScores(gpu: string, reg: number[]): number[] {
    let result = [0, 0, 0, 0];
    let riskLevelOrStun = reg[3+playerIdx];
    let myPosition = reg[playerIdx];
    let opp1Position = reg[(playerIdx+1)%3];
    let opp2Position = reg[(playerIdx+2)%3];
    let howFarAhead = myPosition - Math.max(opp1Position, opp2Position);

    if (gpu === 'GAME_OVER' ||
        reg[6] > turnsRemaining ||
        riskLevelOrStun < 0 ||
        howFarAhead / 3 > reg[6] || // can't lose
        (myPosition + 3*reg[6] < opp1Position || myPosition + 3*reg[6] < opp2Position) // can't win
        ) {
        console.error(`DON'T CARE:`, result);
        return result;
    }

    let riskOrder = gpu.split('').map(d => Object.values(MoveType).filter(v => 'string' === typeof v).findIndex((dir: string) => dir.startsWith(d)));
    console.error({gpu, riskOrder});
    // see if we are about to move onto a spot with a stunned opponent

    if (riskLevelOrStun === 0) {
        // we don't really need to reduce risk
        result[riskOrder[0]] = 0;
        result[riskOrder[1]] = 9;
        result[riskOrder[2]] = 9;
        result[riskOrder[3]] = 10;
    } else if (riskLevelOrStun === 1) {
        result[riskOrder[0]] = 10;
        result[riskOrder[1]] = 10;
        result[riskOrder[2]] = 10;
        result[riskOrder[3]] = 5;
    } else if (riskLevelOrStun === 2) {
        result[riskOrder[0]] = 10;
        result[riskOrder[1]] = 10;
        result[riskOrder[2]] = 5;
        result[riskOrder[3]] = 5;
    } else if (riskLevelOrStun === 3) {
        result[riskOrder[0]] = 10;
        result[riskOrder[1]] = 5;
        result[riskOrder[2]] = 5;
        result[riskOrder[3]] = 0;
    } else if (riskLevelOrStun === 4) {
        result[riskOrder[0]] = 10;
        result[riskOrder[1]] = 10;
        result[riskOrder[2]] = 0;
        result[riskOrder[3]] = 0;
    }

    console.error(`RESULT:`, result)
    return result;
}

function getDivingMoveScores(gpu: string, reg: number[]): number[] {
    let result = [0, 0, 0, 0];
    if (gpu === 'GAME_OVER') {
        console.error(`DON'T CARE:`, result);
        return result;
    }

    let combo = reg[3+playerIdx]
    let myScore = reg[playerIdx];
    let turnsLeft = gpu.length;
    let opp1Score = reg[(playerIdx+1)%3];
    let opp2Score = reg[(playerIdx+2)%3];
    let opp1MaxScore = opp1Score + reg[3+((playerIdx+1)%3)]*turnsLeft + turnsLeft*(turnsLeft+1)/2;
    let opp2MaxScore = opp2Score + reg[3+((playerIdx+2)%3)]*turnsLeft + turnsLeft*(turnsLeft+1)/2;
    let myMaxScore = myScore + combo*turnsLeft + turnsLeft*(turnsLeft+1)/2;

    //console.error({myScore,opp1MaxScore,opp2MaxScore});

    if (turnsLeft > turnsRemaining || // can't finish
        (myScore > opp1MaxScore && myScore > opp2MaxScore) || // can't lose
        (myMaxScore < opp1Score || myMaxScore < opp2Score)) { // can't win
        console.error(`DON'T CARE:`, result);
        return result;
    }

    let nextDirectionIndex = Object.values(MoveType).filter(v => 'string' === typeof v).findIndex((dir: string) => dir.startsWith(gpu[0]));
    result[nextDirectionIndex] = 10;//Math.min(5*(combo+1), 10);
    
    console.error(`RESULT:`, result)
    return result;
}

// game loop
let turnsRemaining = 100;
let winNextGame = [false, false, false, false];
let fixedMultiplier = [,,,];
let gameMultiplier = [1, 1, 8, 10];
while (true) {
    let now = Date.now();
    let score: number[] = [];
    let gameMedalPoints: number[][] = [];
    let maxMedalPoints = 0;
    let opponentMultiplier = [1,1,1,1];
    for (let i = 0; i < 3; i++) {
        const scoreInfo: number[] = readline().split(' ').map(Number);
        score[i] = scoreInfo[0];
        gameMedalPoints[i] = [
            3*scoreInfo[1]+scoreInfo[2],
            3*scoreInfo[4]+scoreInfo[5],
            3*scoreInfo[7]+scoreInfo[8],
            3*scoreInfo[10]+scoreInfo[11],
        ];
        maxMedalPoints = Math.max(maxMedalPoints, ...gameMedalPoints[i]);
    }
    console.error(`Score Info:`, score);
    console.error(`Medal Points Info:`, gameMedalPoints);

    for (let i=0; i<2; i++) {
        let oppIndex = (playerIdx+i)%3;
        //if (score[oppIndex] < score[playerIdx]) continue; // losers!  we don't care about them.  Or do we?
        let mp = gameMedalPoints[oppIndex];
        // sort the medal points so the ind of the event where they have the most points is at the top
        // now, rank scores
        let lastEventScore = -1;
        let eventScoreRank = 0;
        mp.map((score, ind) => ({score, ind}))
          .sort((a,b) => b.score - a.score)
          .map((o, index) => {
            if (lastEventScore !== o.score) {
                lastEventScore = o.score;
                eventScoreRank = index+1;
            }
            opponentMultiplier[o.ind] *= eventScoreRank;
          });
    }

    let moveScores = [0, 0, 0, 0];
    for (let i = 0; i < nbGames; i++) {
        var inputs: string[] = readline().split(' ');
        let gpu: string; 
        let reg: number[];
        gpu = inputs[0];
        reg = inputs.slice(1).map(Number);
        //if (i !== 0) continue;
        let myMedalPoints = gameMedalPoints[playerIdx][i];

        // TODO: Investigate two super adversarial multiplier strategies here
        // - be a predator and cause your opponents to LOSE every match if you find they aren't winning a certain event?
        //   - this would have to be TWO events as you can't cause everybody to lose EVERY match
        //   - and they would have to be two events that you can win perfectly every time.
        //   - so if we picked hurdles and diving, we would have to figure out the best dive pattern to force a win in both of those
        //     and just HOPE that our opponents placed 2/3 and 3/2 so they would each have a 0 for one score.
        //   - then, focus HARD on those two  for the remainder of the 
        // - antagonist - similar idea, but focused on whatever event your opponents are doing poorly in
        //   - since going from 1 points in an event to 2 points is a bigger deal than going from 10 points to 11 points,
        //     we try to keep the opponents scores low where they are already low
        //   - of course, this counteracts the whole multiplier strategy that we want to focus on games where WE are low
        if (gpu === 'GAME_OVER') {
            //gameMultiplier[i] = opponentMultiplier[i]; // 1;
            gameMultiplier[i] = 1;
            // lower total medal points get higher multipliers than higher total medal points
            //gameMultiplier[i] *= Math.max(1, (maxMedalPoints-myMedalPoints)/maxMedalPoints * 8);
            gameMultiplier[i] *= (maxMedalPoints+1)/(myMedalPoints+1) * 10;
    
            // what if we instead say that those at the extremes - either very low or very high, get higher multipliers?
            //gameMultiplier[i] = Math.max(1, (Math.abs(maxMedalPoints/2-thisMedalPoints))/(maxMedalPoints/2) * 8);
        }

        let multiplier = gameMultiplier[i]; // 1 to 8?

        if (myMedalPoints > 0) {
            winNextGame[i] = false;
            fixedMultiplier[i] = undefined;
        } else {
            // panic, we HAVE to win the next game in this category or we will score nothing
            if (turnsRemaining < 25) {
                winNextGame[i] = true;
            }
            if (fixedMultiplier[i] !== undefined) {
                multiplier = fixedMultiplier[i];
            }
            if (winNextGame[i] === true && gpu === 'GAME_OVER') {
                fixedMultiplier[i] = 10;
                winNextGame[i] = false;
            }
        }

        console.error(`Game ${GameType[i]} [${myMedalPoints}] (${multiplier.toFixed(2)}x) = ${inputs}`);

        getMoveScores(gpu, reg, i).forEach((score, index) => moveScores[index] += multiplier*score);
    }

    let bestScore = 0;
    for (let i=0; i<4; i++) {
        console.error(`Move: ${moves[i]} score=${moveScores[i]}`);
        if (moveScores[i] > bestScore) bestScore = moveScores[i];
    }

    let bestScoringMoves = moveScores.map((score, index) => ({score, index})).filter(pair => pair.score === bestScore).map(pair => pair.index);
    console.error('bestScoringMove indexes: ', bestScoringMoves);

    console.error(`Processing time: ${Date.now()-now}`);
    console.log(moves[choice(bestScoringMoves)]);
    turnsRemaining--;
}
